<Window x:Class="ControllerHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControllerHub"
        Height="540" Width="880" MinHeight="420" MinWidth="720"
        Background="#1B1D22" Foreground="#E8E8E8"
        FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colonne gauche : liste des manettes -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Manettes détectées"
                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Button DockPanel.Dock="Bottom" Content="Ouvrir les paramètres Bluetooth"
                    Click="OpenBluetooth_Click" Padding="8,6" Margin="0,8,0,0"/>
            <ListBox x:Name="ControllerList"
                     DisplayMemberPath="Title"
                     SelectionChanged="ControllerList_SelectionChanged"
                     Background="#23262C" BorderThickness="0" Padding="4"/>
        </DockPanel>

        <!-- Colonne droite : détails, appairage et testeur -->
        <DockPanel Grid.Column="1" Margin="16,0,0,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                           Text="Aucune manette sélectionnée"/>
                <TextBlock x:Name="DetailText" Margin="0,4,0,12" Opacity="0.75" TextWrapping="Wrap"/>

                <TextBlock Text="Appairage" FontWeight="SemiBold"/>
                <TextBlock x:Name="PairingText" TextWrapping="Wrap" Margin="0,4,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="VibrateButton" Content="Tester la vibration"
                            Click="Vibrate_Click" Padding="10,4" Margin="0,0,12,0"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7"/>
                </StackPanel>

                <Button x:Name="VirtualPadButton" Content="Activer la conversion Xbox 360"
                        Click="VirtualPadButton_Click" Padding="10,4"
                        HorizontalAlignment="Left" Margin="0,0,0,12"/>

                <TextBlock Text="Lecture en direct" FontWeight="SemiBold" Margin="0,0,0,4"/>
            </StackPanel>

            <TextBox x:Name="TesterText" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                     Background="#23262C" BorderThickness="0" Padding="10"
                     VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</Window>
