<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Projections Windows Runtime (Windows.Gaming.Input) incluses, sans paquet NuGet supplémentaire -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ControllerHub</RootNamespace>
    <AssemblyName>ControllerHub</AssemblyName>
    <ApplicationTitle>ControllerHub</ApplicationTitle>
    <Version>0.2.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Manette virtuelle Xbox 360 : nécessite le pilote ViGEmBus installé sur Windows -->
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <!-- Lecture HID directe de la DualSense (croix directionnelle, sticks) -->
    <PackageReference Include="HidSharp" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="mappings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
